    <string name="welcome_message_welcome">Keep track of what\'s in your fridge, freezer and cupboard, and use it up before the date.</string>
    <string name="welcome_message_scan">Point the camera at a best-before or use-by date. A barcode fills in the product name. Everything is read on your phone.</string>
    <string name="welcome_message_remind">Your fridge is sorted by urgency. The most urgent item sits at the top, with one-tap Used it and Freeze.</string>
    <string name="welcome_message_cook">Recipes are ranked by what\'s already in your fridge, with food that\'s about to expire counted first.</string>
    <string name="welcome_message_reminders">We\'ll remind you a few days before the date, on the day, and if it slips past. You choose when.</string>
